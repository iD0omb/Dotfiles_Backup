{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  



  // LOGO Display
  "logo": 
  {
    "width": 13,
    "type": "kitty-direct",
    "source": "~/.dotfiles/fastfetch/.config/fastfetch/logo/Endfield.png ",
    "padding":{
      "top": 1
    }
  },

  


  
    "display": {
        "separator": "\u001b[38;2;101;113;54m║\u001b[39m",
        "key": {
            "width": 28
        },
        "bar": {
            "border": null,
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 35
        }
    },
  "modules": [

        {
            "type": "custom",
            "format": "{##657136}╔═════════════════════════════════════════════════════════════════════════════════╗"
        },
        {
            "type": "custom",
            "format": "{##657136}║ {##F8F546}███████╗ ███╗   ██╗ ██████╗  ███████╗ ██╗ ███████╗ ██╗      ██████╗             {##657136}║"
        },
        {
            "type": "custom",
            "format": "{##657136}║ {##F8F546}██╔════╝ ████╗  ██║ ██╔══██╗ ██╔════╝ ██║ ██╔════╝ ██║      ██╔══██╗            {##657136}║"
        },
        {
            "type": "custom",
            "format": "{##657136}║ {##F8F546}█████╗   ██╔██╗ ██║ ██║  ██║ █████╗   ██║ █████╗   ██║      ██║  ██║            {##657136}║"
        },
        {
            "type": "custom",
            "format": "{##657136}║ {##F8F546}██╔══╝   ██║╚██╗██║ ██║  ██║ ██╔══╝   ██║ ██╔══╝   ██║      ██║  ██║            {##657136}║"
        },
        {
            "type": "custom",
            "format": "{##657136}║ {##F8F546}███████╗ ██║ ╚████║ ██████╔╝ ██║      ██║ ███████╗ ███████╗ ██████╔╝            {##657136}║"
        },
        {
            "type": "custom",
            "format": "{##657136}║ {##F8F546}╚══════╝ ╚═╝  ╚═══╝ ╚═════╝  ╚═╝      ╚═╝ ╚══════╝ ╚══════╝ ╚═════╝  {##A0AAA9}INDUSTRIES {##657136}║"
        },
        {
            "type": "custom",
            "format": "{##657136}╚═════════════════════════════════════════════════════════════════════════════════╝"
        },






{
      "type": "custom",
      "format": "{##657136}╔═══════════════════════╦═════════════════════════════════════════════════════════╗"
    },
    {
      "key": "{##657136}║ {#33} Endministrator      ",
      "type": "title",
      "format": "{user-name}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33}󰇅 Core AIC            ",
      "type": "title",
      "format": "{host-name}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33}󰅐 Facility Uptime     ",
      "type": "uptime",
      "format": "{1}d {2}h {3}m\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33}{icon} Distribution        ",
      "type": "os",
      "format": "{pretty-name}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33} Kernel              ",
      "type": "kernel",
      "format": "{release}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33}󰇄 Display             ",
      "type": "de",
      "format": "{pretty-name}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33} Terminal            ",
      "type": "terminal",
      "format": "{pretty-name}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33} shell               ",
      "type": "shell",
      "format": "{pretty-name}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33}󰍛 CPU                 ",
      "type": "cpu",
      "showPeCoreCount": true,
      "format": "{name}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33}󰉉 Disk                ",
      "type": "disk",
      "format": "{size-used} / {size-total}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33} Memory              ",
      "type": "memory",
      "format": "{used} / {total}\u001b[82G{##657136}                  ║"
    },
    {
      "key": "{##657136}║ {#33}󰩟 Network             ",
      "type": "localip",
      "format": "{ipv4} ({ifname})\u001b[82G{##657136}                  ║"
    },
    {
      "type": "custom",
      "format": "{##657136}╚═══════════════════════╩═════════════════════════════════════════════════════════╝"
    }, 
  ]
}
