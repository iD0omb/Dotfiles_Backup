{
  "layer": "top",
  "position": "top",
  "margin-top": 3,
  "margin-left": 6, 
  "margin-right": 6,
  "modules-left": [
    "custom/icon",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "temperature",
    "cpu",
    "memory"
  ],
  "modules-right": [
    "battery",
    "backlight",
    "wireplumber",
    "custom/notification",
    "clock",
    "bluetooth",
    "network",
    "custom/power",
    "tray"
  ],
  "include": [
    "~/.config/waybar/modules.jsonc"
  ]
}
